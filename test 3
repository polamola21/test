  D --&gt;|no| I[&quot;Investigate source truth, timing, grain or transform defect&quot;] --&gt; P
  D --&gt;|yes| S[&quot;4 · Squad lead signs off recorded exceptions&quot;]
  S --&gt; X[&quot;5 · Cut over analytical reads; retain rollback&quot;]
  X --&gt; O{&quot;6 · Observation window stable&lt;br/&gt;and downstream dependents migrated?&quot;}
  O --&gt;|no| R[&quot;Rollback or repair; keep legacy analytical path&quot;] --&gt; P
  O --&gt;|yes| Z[&quot;7 · Retire only redundant analytical artefact&quot;]
