  CATEGORY_API["Category API"] --&gt; GATEWAY
  SPECIALIST["Specialist Product API"] --&gt; GATEWAY
  GATEWAY --&gt;|"Event Streaming Platform + batch"| DOCSTORE["Document Database<br>Consumer Team B and Search"]
  GATEWAY --&gt;|"API"| PG["Relational Database / Time-series Database<br>Consumer Team C"]
  GATEWAY --&gt;|"API"| ES["Search Platform<br>Search text matching"]
