  BIZ --&gt; ARCH["Architecture / Technical Lead approval<br>Named approver missing"]
  ARCH --&gt; DA{"Design Authority required?"}
  DA --&gt;|"Yes"| DAA["DA code, date and architect"]
  DA --&gt;|"No"| DG["Data Governance review"]
  DAA --&gt; DG
  DG --&gt; SEC["Information Security determination"]
  SEC --&gt; READY["Requirements approval complete"]
